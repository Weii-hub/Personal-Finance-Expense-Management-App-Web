@model PersonalFinanceApp.Models.Transaction

@{
    ViewData["Title"] = "Thêm Giao Dịch Mới";
}

<link rel="stylesheet" href="~/css/transactions.css" asp-append-version="true" />

<div class="container mt-4" style="max-width: 680px;">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h2 class="mb-1">✍️ Ghi Chép Giao Dịch</h2>
            <p class="text-muted mb-0">Thêm khoản thu nhập hoặc chi tiêu vào ví của bạn.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fa-solid fa-arrow-left me-1"></i> Quay lại
        </a>
    </div>

    <div class="transaction-form-card">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <!-- Số tiền -->
            <div class="mb-3">
                <label asp-for="Amount" class="form-label fw-bold">Số tiền (VNĐ) <span class="text-danger">*</span></label>
                <div class="input-group input-group-lg">
                    <span class="input-group-text bg-light text-primary fw-bold">₫</span>
                    <input asp-for="Amount" id="Amount" type="number" min="1" step="1000" class="form-control fw-bold fs-4 text-primary" placeholder="0" autofocus required />
                </div>
                <span asp-validation-for="Amount" class="text-danger small"></span>
            </div>

            <!-- Danh mục -->
            <div class="mb-3">
                <label asp-for="CategoryId" class="form-label fw-bold">Danh mục <span class="text-danger">*</span></label>
                <select asp-for="CategoryId" id="CategoryId" class="form-select form-select-lg" asp-items="ViewBag.CategoryId" required>
                    <option value="">-- Chọn danh mục thu / chi --</option>
                </select>
                <span asp-validation-for="CategoryId" class="text-danger small"></span>
                <div class="form-text">Chưa có danh mục bạn cần? <a asp-controller="Categories" asp-action="Create" target="_blank">Tạo thêm danh mục</a></div>
            </div>

            <!-- Ví tiền -->
            <div class="mb-3">
                <label asp-for="WalletId" class="form-label fw-bold">Ví thanh toán <span class="text-danger">*</span></label>
                <select asp-for="WalletId" id="WalletId" class="form-select form-select-lg" asp-items="ViewBag.WalletId" required>
                    <option value="">-- Chọn ví nhận hoặc trừ tiền --</option>
                </select>
                <span asp-validation-for="WalletId" class="text-danger small"></span>
            </div>

            <!-- Cảnh Báo Số Dư Âm Thông Minh (Soft Overdraft Warning theo chuẩn công ty phần mềm) -->
            <div id="overdraftWarning" class="alert alert-warning rounded-4 shadow-sm mb-3 d-none" style="border: 2px solid #ffd43b; background-color: #fff9db;">
                <div class="d-flex align-items-start">
                    <i class="fa-solid fa-triangle-exclamation text-warning fs-3 me-3 mt-1"></i>
                    <div>
                        <strong class="text-dark d-block mb-1">⚠️ Lưu ý: Khoản chi vượt số dư ví!</strong>
                        <div id="overdraftDetails" class="small text-muted mb-0"></div>
                    </div>
                </div>
            </div>

            <!-- Thời gian giao dịch -->
            <div class="mb-3">
                <label asp-for="TransactionDate" class="form-label fw-bold">Thời gian giao dịch</label>
                <input asp-for="TransactionDate" type="datetime-local" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                <span asp-validation-for="TransactionDate" class="text-danger small"></span>
            </div>

            <!-- Ghi chú -->
            <div class="mb-4">
                <label asp-for="Note" class="form-label fw-bold">Ghi chú (Tùy chọn)</label>
                <input asp-for="Note" class="form-control" placeholder="Ví dụ: Ăn trưa bún bò, Tiền lương tháng 10..." maxlength="255" />
                <span asp-validation-for="Note" class="text-danger small"></span>
            </div>

            <!-- Nút bấm -->
            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-primary btn-lg shadow-sm">
                    <i class="fa-solid fa-check me-1"></i> Lưu Giao Dịch
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        const walletsData = @Html.Raw(ViewBag.WalletsBalanceJson ?? "{}");
        const categoriesData = @Html.Raw(ViewBag.CategoriesTypeJson ?? "{}");

        function checkOverdraft() {
            const amountInput = document.getElementById('Amount');
            const walletSelect = document.getElementById('WalletId');
            const categorySelect = document.getElementById('CategoryId');
            const warningBox = document.getElementById('overdraftWarning');
            const detailsBox = document.getElementById('overdraftDetails');

            if (!amountInput || !walletSelect || !categorySelect || !warningBox) return;

            const amount = parseFloat(amountInput.value) || 0;
            const walletId = walletSelect.value;
            const categoryId = categorySelect.value;

            if (!walletId || !categoryId || amount <= 0) {
                warningBox.classList.add('d-none');
                return;
            }

            const categoryType = categoriesData[categoryId]; // 0: Chi tiêu, 1: Thu nhập
            const wallet = walletsData[walletId];

            if (categoryType === 0 && wallet) {
                const currentBalance = wallet.Balance;
                if (amount > currentBalance) {
                    const newBalance = currentBalance - amount;
                    detailsBox.innerHTML = `Ví <strong>${wallet.Name}</strong> hiện có <strong>${currentBalance.toLocaleString('vi-VN')} đ</strong>. Sau khoản chi này, số dư ví sẽ bị <strong>âm: ${newBalance.toLocaleString('vi-VN')} đ</strong>. Bạn vẫn có thể tiếp tục lưu nếu đây là khoản thấu chi/tiêu trước trả sau.`;
                    warningBox.classList.remove('d-none');
                    return;
                }
            }
            warningBox.classList.add('d-none');
        }

        document.addEventListener('DOMContentLoaded', function () {
            const amountInput = document.getElementById('Amount');
            const walletSelect = document.getElementById('WalletId');
            const categorySelect = document.getElementById('CategoryId');

            if (amountInput) amountInput.addEventListener('input', checkOverdraft);
            if (walletSelect) walletSelect.addEventListener('change', checkOverdraft);
            if (categorySelect) categorySelect.addEventListener('change', checkOverdraft);

            checkOverdraft();
        });
    </script>
}
