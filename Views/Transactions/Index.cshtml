@model IEnumerable<PersonalFinanceApp.Models.Transaction>

@{
    ViewData["Title"] = "Quản lý Giao dịch";
    decimal totalIncome = ViewBag.TotalIncome ?? 0m;
    decimal totalExpense = ViewBag.TotalExpense ?? 0m;
    decimal netBalance = ViewBag.NetBalance ?? 0m;
}

<link rel="stylesheet" href="~/css/transactions.css" asp-append-version="true" />

<div class="container mt-4">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="mb-1">💸 Sổ Giao Dịch</h2>
            <p class="text-muted mb-0">Theo dõi chi tiết các khoản thu nhập và chi tiêu hàng ngày.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary btn-lg shadow-sm">
            <i class="fa-solid fa-plus me-1"></i> Ghi chép mới
        </a>
    </div>

    <!-- Thông báo Success / Error -->
    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i> @success
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    <!-- 3 Thẻ thống kê tổng quan -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="transaction-summary-card income-card">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small text-uppercase fw-bold">Tổng Thu Nhập</span>
                        <h3 class="mb-0 text-success fw-bold mt-1">+@totalIncome.ToString("N0") đ</h3>
                    </div>
                    <div class="p-3 bg-success-subtle text-success rounded-circle">
                        <i class="fa-solid fa-arrow-trend-up fa-xl"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="transaction-summary-card expense-card">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small text-uppercase fw-bold">Tổng Chi Tiêu</span>
                        <h3 class="mb-0 text-danger fw-bold mt-1">-@totalExpense.ToString("N0") đ</h3>
                    </div>
                    <div class="p-3 bg-danger-subtle text-danger rounded-circle">
                        <i class="fa-solid fa-arrow-trend-down fa-xl"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="transaction-summary-card net-card">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small text-uppercase fw-bold">Thu Chi Ròng</span>
                        <h3 class="mb-0 @(netBalance >= 0 ? "text-primary" : "text-danger") fw-bold mt-1">
                            @(netBalance >= 0 ? "+" : "")@netBalance.ToString("N0") đ
                        </h3>
                    </div>
                    <div class="p-3 bg-primary-subtle text-primary rounded-circle">
                        <i class="fa-solid fa-scale-balanced fa-xl"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Khung Bộ lọc (Filters) -->
    <div class="transaction-filter-card mb-4">
        <form method="get" asp-action="Index" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-bold text-muted">Ví thanh toán</label>
                <select name="walletId" class="form-select">
                    <option value="">-- Tất cả ví --</option>
                    @if (ViewBag.Wallets != null)
                    {
                        foreach (var w in (IEnumerable<PersonalFinanceApp.Models.Wallet>)ViewBag.Wallets)
                        {
                            <option value="@w.Id" selected="@(ViewBag.SelectedWalletId == w.Id)">@w.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold text-muted">Danh mục</label>
                <select name="categoryId" class="form-select">
                    <option value="">-- Tất cả danh mục --</option>
                    @if (ViewBag.Categories != null)
                    {
                        foreach (var c in (IEnumerable<PersonalFinanceApp.Models.Category>)ViewBag.Categories)
                        {
                            <option value="@c.Id" selected="@(ViewBag.SelectedCategoryId == c.Id)">
                                @(c.Type == 1 ? "➕ [Thu]" : "➖ [Chi]") @c.Name
                            </option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold text-muted">Loại</label>
                <select name="type" class="form-select">
                    <option value="">-- Thu & Chi --</option>
                    <option value="1" selected="@(ViewBag.SelectedType == 1)">Chỉ Thu nhập</option>
                    <option value="0" selected="@(ViewBag.SelectedType == 0)">Chỉ Chi tiêu</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold text-muted">Từ ngày</label>
                <input type="date" name="fromDate" value="@ViewBag.FromDate" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold text-muted">Đến ngày</label>
                <input type="date" name="toDate" value="@ViewBag.ToDate" class="form-control" />
            </div>
            <div class="col-12 d-flex justify-content-end gap-2 mt-3">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="fa-solid fa-rotate-left me-1"></i> Xóa lọc
                </a>
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-filter me-1"></i> Lọc dữ liệu
                </button>
            </div>
        </form>
    </div>

    <!-- Bảng danh sách giao dịch -->
    <div class="transaction-panel">
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <div class="display-3 mb-3">🍃</div>
                <h5>Chưa có giao dịch nào</h5>
                <p class="text-muted">Ghi lại khoản thu hoặc chi đầu tiên để bắt đầu quản lý tài chính nhé!</p>
                <a asp-action="Create" class="btn btn-outline-primary mt-2">
                    <i class="fa-solid fa-plus me-1"></i> Thêm giao dịch ngay
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Danh mục / Ghi chú</th>
                            <th>Ví tiền</th>
                            <th>Thời gian</th>
                            <th class="text-end">Số tiền</th>
                            <th class="text-end">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var isIncome = item.Category?.Type == 1;
                            var categoryColor = string.IsNullOrEmpty(item.Category?.Color) ? (isIncome ? "#20c997" : "#ff6b81") : item.Category.Color;
                            var categoryIcon = string.IsNullOrEmpty(item.Category?.Icon) ? (isIncome ? "fa-wallet" : "fa-tag") : item.Category.Icon;

                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="transaction-badge-icon" style="background: color-mix(in srgb, @categoryColor 15%, white); color: @categoryColor;">
                                            <i class="fa-solid @categoryIcon"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark">@(item.Category?.Name ?? "Không rõ")</div>
                                            @if (!string.IsNullOrEmpty(item.Note))
                                            {
                                                <small class="text-muted">@item.Note</small>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge-wallet">
                                        <i class="fa-solid @(item.Wallet?.Icon ?? "fa-wallet") me-1"></i>
                                        @(item.Wallet?.Name ?? "Ví không tên")
                                    </span>
                                </td>
                                <td>
                                    <small class="text-muted">
                                        <i class="fa-regular fa-clock me-1"></i>
                                        @item.TransactionDate.ToString("dd/MM/yyyy HH:mm")
                                    </small>
                                </td>
                                <td class="text-end">
                                    <span class="@(isIncome ? "amount-income" : "amount-expense")">
                                        @(isIncome ? "+" : "-")@item.Amount.ToString("N0") đ
                                    </span>
                                </td>
                                <td class="text-end">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary me-1" title="Chỉnh sửa">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Xóa">
                                        <i class="fa-solid fa-trash-can"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
