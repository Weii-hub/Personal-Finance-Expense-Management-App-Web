@model PersonalFinanceApp.Models.SavingsGoal
@{
    ViewData["Title"] = "Chi tiết mục tiêu: " + Model.Name;
    var wallets = ViewBag.Wallets as IEnumerable<PersonalFinanceApp.Models.Wallet> ?? Enumerable.Empty<PersonalFinanceApp.Models.Wallet>();
    bool isBankGoal = Model.GoalType == 1;
    bool hasPin = ViewBag.HasPin == true;
}

<div class="container py-4" style="max-width: 880px;">
    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none fw-semibold"><i class="fa-solid fa-arrow-left me-1"></i> Danh sách mục tiêu</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    @if (TempData["AdvisoryNotice"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show rounded-4 shadow-sm border-0" role="alert" style="background: #fff9db; color: #744210; border-left: 5px solid #f59f00 !important;">
            <i class="fa-solid fa-lightbulb fa-lg me-2 text-warning"></i>
            <strong>@TempData["AdvisoryNotice"]</strong>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    <!-- Thẻ Tổng quan Mục Tiêu -->
    <div class="card border-0 rounded-4 shadow-sm mb-4" style="border: 2px solid #e0e7ff !important; background: #ffffff;">
        <div class="card-body p-4 p-md-5">
            <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                <div>
                    <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
                        <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2">
                            <i class="fa-solid fa-bullseye me-1"></i> Kế hoạch tích lũy
                        </span>
                        @if (isBankGoal)
                        {
                            <span class="badge bg-info-subtle text-dark rounded-pill px-3 py-2">
                                <i class="fa-solid fa-building-columns text-primary me-1"></i> Mục tiêu Ngân Hàng
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-success-subtle text-success rounded-pill px-3 py-2">
                                <i class="fa-solid fa-piggy-bank me-1"></i> Mục tiêu Tiền Mặt
                            </span>
                        }
                    </div>
                    <h2 class="fw-bold mb-1 text-dark">@Model.Name</h2>
                    <p class="text-muted mb-0 small">
                        <i class="fa-regular fa-calendar me-1"></i>
                        @(Model.TargetDate.HasValue ? $"Ngày dự kiến hoàn thành: {Model.TargetDate.Value:dd/MM/yyyy}" : "Chưa đặt ngày hoàn thành")
                    </p>
                </div>
                @if (Model.IsCompleted)
                {
                    <span class="badge bg-success rounded-pill px-3 py-2 fs-6 shadow-sm">
                        <i class="fa-solid fa-circle-check me-1"></i> Đã hoàn thành mục tiêu!
                    </span>
                }
            </div>

            <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
                <div>
                    <div class="text-muted small text-uppercase fw-bold">Số tiền đã tích lũy</div>
                    <div class="display-6 fw-bold text-success">@Model.CurrentAmount.ToString("N0") <small class="fs-6">đ</small></div>
                </div>
                <div class="text-md-end">
                    <div class="text-muted small text-uppercase fw-bold">Mục tiêu cần đạt</div>
                    <div class="fs-4 fw-bold text-primary">@Model.TargetAmount.ToString("N0") đ</div>
                </div>
            </div>

            <!-- Thanh Tiến Độ -->
            <div class="progress mb-2 rounded-pill shadow-inner" role="progressbar" aria-label="Tiến độ tiết kiệm" aria-valuenow="@Model.ProgressPercentage" aria-valuemin="0" aria-valuemax="100" style="height: 18px; background-color: #eef2ff;">
                <div class="progress-bar progress-bar-striped progress-bar-animated @(Model.IsCompleted ? "bg-success" : "bg-primary") rounded-pill" style="width: @Model.ProgressPercentage.ToString(System.Globalization.CultureInfo.InvariantCulture)%"></div>
            </div>
            <div class="d-flex justify-content-between small text-muted fw-semibold">
                <span><i class="fa-solid fa-chart-line text-primary me-1"></i> @Model.ProgressPercentage.ToString("0.#")% hoàn thành</span>
                <span>@(Model.IsCompleted ? "🎉 Chúc mừng bạn đã hoàn tất mục tiêu!" : $"Còn thiếu: {Model.RemainingAmount.ToString("N0")} đ")</span>
            </div>
        </div>
    </div>

    <!-- KHU VỰC THAO TÁC TIỀN TỆ LIÊN KẾT VỚI VÍ -->
    <div class="row g-4 mb-4">
        <!-- 1. Form Nạp tiền từ ví vào mục tiêu -->
        <div class="col-12 @(Model.CurrentAmount > 0 ? "col-lg-6" : "")">
            <div class="card border-0 rounded-4 shadow-sm h-100" style="border: 2px solid #e6fcf5 !important; background: #ffffff;">
                <div class="card-body p-4">
                    <h5 class="fw-bold text-success mb-2">
                        <i class="fa-solid fa-arrow-down-to-bracket me-2"></i>Nạp tiền vào mục tiêu
                    </h5>
                    
                    @if (isBankGoal)
                    {
                        <p class="text-muted small mb-3">
                            <i class="fa-solid fa-shield-halved text-primary me-1"></i>
                            Mục tiêu này chỉ trích từ <strong>Ví Ngân Hàng</strong> đã được bật quyền. Yêu cầu nhập <strong>Mã PIN 6 số</strong> để trừ tiền.
                        </p>
                    }
                    else
                    {
                        <p class="text-muted small mb-3">
                            <i class="fa-solid fa-money-bill-wave text-success me-1"></i>
                            Mục tiêu này chỉ trích từ <strong>Ví Tiền Mặt</strong> ngoài đời.
                        </p>
                    }

                    @if (wallets.Any())
                    {
                        <form id="addFundsForm" asp-action="AddFunds" asp-route-id="@Model.Id" method="post" autocomplete="off" onsubmit="return handleAddFundsSubmit(event)">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="pin" id="pinForAddFunds" value="" />

                            <div class="mb-3">
                                <label for="walletId" class="form-label small fw-bold text-muted">Trích tiền từ ví:</label>
                                <select id="walletId" name="walletId" class="form-select form-select-lg" required>
                                    @foreach (var w in wallets)
                                    {
                                        <option value="@w.Id">
                                            @w.Name (Khả dụng: @w.InitialBalance.ToString("N0") đ)
                                        </option>
                                    }
                                </select>
                            </div>
                            <div class="mb-3">
                                <label for="amount" class="form-label small fw-bold text-muted">Số tiền nạp (VNĐ):</label>
                                <input id="amount" name="amount" type="number" min="1000" step="any" class="form-control form-control-lg" placeholder="Ví dụ: 500000" required />
                            </div>
                            <div class="d-grid">
                                <button type="submit" class="btn btn-success btn-lg shadow-sm">
                                    <i class="fa-solid fa-plus me-1"></i> Trích ví nạp vào mục tiêu
                                </button>
                            </div>
                        </form>
                    }
                    else
                    {
                        @if (isBankGoal)
                        {
                            <div class="alert alert-warning mb-0 small rounded-4 p-3 border-0" style="background: #fff3bf; color: #744210;">
                                <div class="fw-bold mb-1"><i class="fa-solid fa-triangle-exclamation me-1"></i> Không có ví ngân hàng khả dụng!</div>
                                <div>Mục tiêu này cần ví Ngân Hàng có bật công tắc <strong>"Cho phép trích tiết kiệm"</strong>.</div>
                                <div class="mt-2">
                                    <a asp-controller="Wallets" asp-action="Index" class="btn btn-sm btn-warning text-dark fw-bold rounded-pill">
                                        <i class="fa-solid fa-wallet me-1"></i> Đến Quản Lý Ví để bật quyền
                                    </a>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-warning mb-0 small rounded-3">
                                <i class="fa-solid fa-triangle-exclamation me-1"></i> Bạn chưa có ví tiền mặt nào để trích nạp. Hãy <a asp-controller="Wallets" asp-action="Create" class="fw-bold">tạo ví trước</a> nhé!
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <!-- 2. Form Rút tiền từ mục tiêu hoàn trả về ví (Chỉ hiện khi đã có tiền tích lũy) -->
        @if (Model.CurrentAmount > 0)
        {
            <div class="col-12 col-lg-6">
                <div class="card border-0 rounded-4 shadow-sm h-100" style="border: 2px solid #fff3bf !important; background: #ffffff;">
                    <div class="card-body p-4">
                        <h5 class="fw-bold text-warning-emphasis mb-2">
                            <i class="fa-solid fa-arrow-up-from-bracket me-2 text-warning"></i>Rút tiền về ví
                        </h5>
                        <p class="text-muted small mb-3">
                            Chuyển tiền từ mục tiêu về lại ví cùng loại khi cần chi tiêu đột xuất hoặc thu hồi vốn.
                        </p>

                        @if (wallets.Any())
                        {
                            <form asp-action="WithdrawFunds" asp-route-id="@Model.Id" method="post" autocomplete="off" onsubmit="return confirm('Bạn có chắc muốn rút tiền từ mục tiêu này về ví?');">
                                @Html.AntiForgeryToken()
                                <div class="mb-3">
                                    <label for="withdrawWalletId" class="form-label small fw-bold text-muted">Chuyển tiền về ví:</label>
                                    <select id="withdrawWalletId" name="walletId" class="form-select form-select-lg" required>
                                        @foreach (var w in wallets)
                                        {
                                            <option value="@w.Id">
                                                @w.Name (Hiện có: @w.InitialBalance.ToString("N0") đ)
                                            </option>
                                        }
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label for="withdrawAmount" class="form-label small fw-bold text-muted">Số tiền rút (Tối đa: @Model.CurrentAmount.ToString("N0") đ):</label>
                                    <input id="withdrawAmount" name="amount" type="number" min="1000" max="@Model.CurrentAmount" step="any" class="form-control form-control-lg" placeholder="Ví dụ: 200000" required />
                                </div>
                                <div class="d-grid">
                                    <button type="submit" class="btn btn-outline-warning text-dark fw-bold btn-lg shadow-sm">
                                        <i class="fa-solid fa-hand-holding-dollar me-1"></i> Rút tiền về ví
                                    </button>
                                </div>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Nút Hành Động Phụ -->
    <div class="d-flex flex-wrap gap-2 pt-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary rounded-pill px-4">
            <i class="fa-solid fa-pen me-1"></i> Chỉnh sửa mục tiêu
        </a>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Bạn có chắc muốn xóa mục tiêu này? Lưu ý: thao tác này không làm thay đổi số dư các ví đã trích.');">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-danger rounded-pill px-4">
                <i class="fa-solid fa-trash me-1"></i> Xóa mục tiêu
            </button>
        </form>
    </div>
</div>

<!-- MODAL NHẬP MÃ PIN ĐỂ TRÍCH TIỀN NGÂN HÀNG VÀO MỤC TIÊU -->
@if (isBankGoal)
{
    <div class="modal fade" id="goalPinModal" tabindex="-1" aria-labelledby="goalPinModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
            <div class="modal-content rounded-4 border-0 shadow">
                <div class="modal-header border-0 pb-0">
                    <div>
                        <h5 class="modal-title fw-bold text-dark" id="goalPinModalLabel">
                            <i class="fa-solid fa-lock text-primary me-2"></i> Xác Thực Mã PIN Giao Dịch
                        </h5>
                        <p class="text-muted small mb-0">Nhập mã PIN 6 số để xác nhận trích tiền từ ví ngân hàng</p>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-4">
                        <input type="password" id="inputGoalPin" class="form-control form-control-lg text-center fw-bold fs-3" maxlength="6" pattern="[0-9]{6}" inputmode="numeric" placeholder="••••••" autofocus />
                    </div>
                    <div class="d-grid">
                        <button type="button" class="btn btn-success btn-lg rounded-pill fw-bold shadow-sm" onclick="confirmPinAndSubmit()">
                            <i class="fa-solid fa-circle-check me-1"></i> Xác Nhận Trích Tiền
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        const isBankGoal = @(isBankGoal ? "true" : "false");
        const hasPin = @(hasPin ? "true" : "false");

        function handleAddFundsSubmit(e) {
            if (!isBankGoal) {
                // Ví tiền mặt: cho phép submit bình thường
                return true;
            }

            // Ví ngân hàng: bắt buộc xác thực PIN
            e.preventDefault();

            if (!hasPin) {
                alert('Bạn chưa thiết lập Mã PIN bảo mật! Vui lòng vào trang Quản lý Ví để thiết lập mã PIN 6 số trước khi trích tiền ngân hàng.');
                return false;
            }

            const pinInput = document.getElementById('pinForAddFunds').value;
            if (!pinInput) {
                document.getElementById('inputGoalPin').value = '';
                const modal = new bootstrap.Modal(document.getElementById('goalPinModal'));
                modal.show();
                return false;
            }

            return true;
        }

        function confirmPinAndSubmit() {
            const pin = document.getElementById('inputGoalPin').value.trim();
            if (pin.length !== 6) {
                alert('Vui lòng nhập đúng 6 chữ số Mã PIN!');
                return;
            }

            document.getElementById('pinForAddFunds').value = pin;
            bootstrap.Modal.getInstance(document.getElementById('goalPinModal')).hide();
            document.getElementById('addFundsForm').submit();
        }
    </script>
}
