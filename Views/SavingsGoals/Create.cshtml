@model PersonalFinanceApp.Models.SavingsGoal
@{
    ViewData["Title"] = "Tạo mục tiêu tiết kiệm";
}

<div class="container py-4" style="max-width: 720px;">
    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none"><i class="fa-solid fa-arrow-left me-1"></i> Quay lại</a>
        <h2 class="fw-bold mt-3"><i class="fa-solid fa-bullseye text-primary me-2"></i>Tạo mục tiêu tiết kiệm</h2>
        <p class="text-muted">Đặt mục tiêu rõ ràng để dễ dàng theo dõi tiến độ.</p>
    </div>
    <div class="card border-0 shadow-sm"><div class="card-body p-4">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-3">
                <label asp-for="Name" class="form-label fw-semibold"></label>
                <input asp-for="Name" class="form-control" placeholder="Ví dụ: Mua laptop mới" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="TargetAmount" class="form-label fw-semibold"></label>
                <div class="input-group">
                    <input asp-for="TargetAmount" class="form-control" type="number" min="1000" step="any" placeholder="10000000" />
                    <span class="input-group-text">VNĐ</span>
                </div>
                <span asp-validation-for="TargetAmount" class="text-danger small"></span>
            </div>
            <div class="mb-4">
                <label asp-for="TargetDate" class="form-label fw-semibold"></label>
                <input asp-for="TargetDate" class="form-control" type="date" />
                <span asp-validation-for="TargetDate" class="text-danger small"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary rounded-pill px-4"><i class="fa-solid fa-floppy-disk me-1"></i> Lưu mục tiêu</button>
                <a asp-action="Index" class="btn btn-light rounded-pill px-4">Hủy</a>
            </div>
        </form>
    </div></div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
