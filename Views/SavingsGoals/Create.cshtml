@model PersonalFinanceApp.Models.SavingsGoal
@{
    ViewData["Title"] = "Tạo mục tiêu tiết kiệm";
}

<div class="container py-4" style="max-width: 720px;">
    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none fw-semibold"><i class="fa-solid fa-arrow-left me-1"></i> Quay lại danh sách</a>
        <h2 class="fw-bold mt-3"><i class="fa-solid fa-bullseye text-primary me-2"></i>Tạo mục tiêu tiết kiệm</h2>
        <p class="text-muted">Đặt mục tiêu tài chính rõ ràng để dễ dàng tích lũy và kiểm soát chi tiêu.</p>
    </div>

    <div class="card border-0 rounded-4 shadow-sm" style="border: 2px solid #e0e7ff !important; background: #ffffff;">
        <div class="card-body p-4 p-md-5">
            <form asp-action="Create" method="post" autocomplete="off">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 mb-3"></div>

                <!-- CHỌN PHÂN LOẠI MỤC TIÊU TIẾT KIỆM (STRICT WALLET TYPE LOCK) -->
                <div class="mb-4">
                    <label class="form-label fw-bold">Loại mục tiêu tích lũy <span class="text-danger">*</span></label>
                    <div class="row g-2">
                        <div class="col-6">
                            <input type="radio" class="btn-check" name="GoalType" id="goalTypeCash" value="0" @(Model.GoalType == 0 ? "checked" : "")>
                            <label class="btn btn-outline-success w-100 p-3 rounded-4 text-start h-100 d-flex flex-column justify-content-between" for="goalTypeCash">
                                <div>
                                    <i class="fa-solid fa-piggy-bank fa-xl mb-2 text-success"></i>
                                    <div class="fw-bold">Tích Lũy Tiền Mặt</div>
                                </div>
                                <small class="text-muted mt-1" style="font-size: 0.8rem;">Trích từ ví tiền mặt ngoài đời (heo đất, két sắt)</small>
                            </label>
                        </div>
                        <div class="col-6">
                            <input type="radio" class="btn-check" name="GoalType" id="goalTypeBank" value="1" @(Model.GoalType == 1 ? "checked" : "")>
                            <label class="btn btn-outline-primary w-100 p-3 rounded-4 text-start h-100 d-flex flex-column justify-content-between" for="goalTypeBank">
                                <div>
                                    <i class="fa-solid fa-building-columns fa-xl mb-2 text-primary"></i>
                                    <div class="fw-bold">Tích Lũy Ngân Hàng</div>
                                </div>
                                <small class="text-muted mt-1" style="font-size: 0.8rem;">Trích từ ví ngân hàng (yêu cầu xác thực Mã PIN 6 số)</small>
                            </label>
                        </div>
                    </div>
                </div>

                <!-- Tên mục tiêu -->
                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-bold"></label>
                    <input asp-for="Name" class="form-control form-control-lg" placeholder="Ví dụ: Mua bàn phím cơ, Du lịch Đà Lạt..." required autofocus />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <!-- Số tiền cần đạt -->
                <div class="mb-3">
                    <label asp-for="TargetAmount" class="form-label fw-bold"></label>
                    <div class="input-group input-group-lg">
                        <span class="input-group-text bg-light text-primary fw-bold">₫</span>
                        <input asp-for="TargetAmount" class="form-control fw-bold fs-5 text-primary" type="number" min="1000" step="any" placeholder="Ví dụ: 2500000" required />
                    </div>
                    <span asp-validation-for="TargetAmount" class="text-danger small"></span>
                </div>

                <!-- Ngày dự kiến -->
                <div class="mb-4">
                    <label asp-for="TargetDate" class="form-label fw-bold"></label>
                    <input asp-for="TargetDate" class="form-control" type="date" />
                    <span asp-validation-for="TargetDate" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2 pt-2">
                    <button type="submit" class="btn btn-primary btn-lg rounded-pill px-4 shadow-sm">
                        <i class="fa-solid fa-floppy-disk me-1"></i> Lưu mục tiêu
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-lg rounded-pill px-4">Hủy</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
