@model PersonalFinanceApp.Models.Category

@{
    ViewData["Title"] = "Sửa danh mục";
}

<div class="container mt-4 mb-5" style="max-width: 640px;">
    <!-- Tiêu đề & Nút quay lại -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h2 class="mb-1"><i class="fa-solid fa-pen-to-square text-primary me-2"></i> Chỉnh Sửa Danh Mục</h2>
            <p class="text-muted mb-0">Cập nhật tên gọi, biểu tượng hoặc loại danh mục.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fa-solid fa-arrow-left me-1"></i> Quay lại
        </a>
    </div>

    <!-- Khung form chính căn giữa màn hình -->
    <div class="card border-0 rounded-4 shadow-sm p-4" style="background: #ffffff; border: 2px solid #e0e7ff !important;">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post" autocomplete="off">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>
            <partial name="_CategoryForm" model="Model" />
            <div class="d-grid gap-2 mt-4">
                <button type="submit" class="btn btn-primary btn-lg shadow-sm">
                    <i class="fa-solid fa-check me-1"></i> Lưu Thay Đổi
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const type = document.getElementById('Type');
            const preview = document.getElementById('categoryPreview');
            const label = document.getElementById('categoryTypeLabel');
            function updatePreview() {
                const income = type.value === '1';
                preview.style.backgroundColor = income ? '#198754' : '#dc3545';
                label.textContent = income ? 'Thu nhập' : 'Chi tiêu';
            }
            if (type && preview && label) {
                type.addEventListener('change', updatePreview);
                updatePreview();
            }
        })();
    </script>
}
