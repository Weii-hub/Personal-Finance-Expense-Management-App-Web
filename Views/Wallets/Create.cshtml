@model PersonalFinanceApp.Models.Wallet

@{
    ViewData["Title"] = "Thêm Ví Mới";
}

<div class="container mt-4 mb-5" style="max-width: 620px;">
    <!-- Tiêu đề & Nút quay lại -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h2 class="mb-1"><i class="fa-solid fa-wallet text-success me-2"></i> Thêm Ví Mới</h2>
            <p class="text-muted mb-0">Khởi tạo nguồn tiền mới (Tiền mặt, Tài khoản ngân hàng, Ví điện tử) để bắt đầu ghi chép.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fa-solid fa-arrow-left me-1"></i> Quay lại
        </a>
    </div>

    <!-- Khung form chính căn giữa màn hình -->
    <div class="card border-0 rounded-4 shadow-sm p-4 p-md-4" style="background: #ffffff; border: 2px solid #e0e7ff !important;">
        <form asp-action="Create" method="post" autocomplete="off">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <!-- Tên ví -->
            <div class="mb-3">
                <label asp-for="Name" class="form-label fw-bold">Tên ví <span class="text-danger">*</span></label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted"><i class="fa-solid fa-wallet"></i></span>
                    <input asp-for="Name" class="form-control form-control-lg" placeholder="Ví dụ: Ví Tiền Mặt, MoMo, Techcombank..." required autofocus />
                </div>
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <!-- Số dư ban đầu -->
            <div class="mb-3">
                <label asp-for="InitialBalance" class="form-label fw-bold">Số dư ban đầu (VNĐ) <span class="text-danger">*</span></label>
                <div class="input-group input-group-lg">
                    <span class="input-group-text bg-light text-success fw-bold">₫</span>
                    <input asp-for="InitialBalance" type="number" step="any" min="0" class="form-control fw-bold fs-5 text-success" placeholder="0" value="0" required />
                </div>
                <span asp-validation-for="InitialBalance" class="text-danger small"></span>
                <div class="form-text text-muted small">
                    <i class="fa-solid fa-circle-info me-1 text-primary"></i> Số tiền thực tế hiện có trong ví của bạn tại thời điểm bắt đầu theo dõi.
                </div>
            </div>

            <!-- Biểu tượng Icon -->
            <div class="mb-4">
                <label asp-for="Icon" class="form-label fw-bold">Biểu tượng Icon (FontAwesome)</label>
                <div class="input-group mb-2">
                    <span class="input-group-text bg-light text-muted">
                        <i id="iconPreview" class="fa-solid fa-wallet fa-lg text-primary"></i>
                    </span>
                    <input asp-for="Icon" id="IconInput" class="form-control" value="fa-wallet" placeholder="fa-wallet, fa-mobile-screen..." />
                </div>
                <span asp-validation-for="Icon" class="text-danger small"></span>

                <!-- Gợi ý biểu tượng -->
                <div class="small text-muted mb-2 fw-semibold">Gợi ý biểu tượng phổ biến (Bấm để chọn):</div>
                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary icon-select-btn" data-icon="fa-wallet">
                        <i class="fa-solid fa-wallet me-1"></i> Ví tiền
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary icon-select-btn" data-icon="fa-building-columns">
                        <i class="fa-solid fa-building-columns me-1"></i> Ngân hàng
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary icon-select-btn" data-icon="fa-mobile-screen">
                        <i class="fa-solid fa-mobile-screen me-1"></i> Ví điện tử
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary icon-select-btn" data-icon="fa-piggy-bank">
                        <i class="fa-solid fa-piggy-bank me-1"></i> Heo đất
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary icon-select-btn" data-icon="fa-credit-card">
                        <i class="fa-solid fa-credit-card me-1"></i> Thẻ tín dụng
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary icon-select-btn" data-icon="fa-money-bill-wave">
                        <i class="fa-solid fa-money-bill-wave me-1"></i> Tiền mặt
                    </button>
                </div>
            </div>

            <!-- Nút bấm tạo ví -->
            <div class="d-grid gap-2 pt-2">
                <button type="submit" class="btn btn-primary btn-lg shadow-sm">
                    <i class="fa-solid fa-plus me-1"></i> Tạo Ví Mới
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        document.querySelectorAll('.icon-select-btn').forEach(btn => {
            btn.addEventListener('click', function () {
                const icon = this.getAttribute('data-icon');
                document.getElementById('IconInput').value = icon;
                document.getElementById('iconPreview').className = `fa-solid ${icon} fa-lg text-primary`;
            });
        });

        document.getElementById('IconInput').addEventListener('input', function () {
            const icon = this.value.trim();
            document.getElementById('iconPreview').className = `fa-solid ${icon || 'fa-wallet'} fa-lg text-primary`;
        });
    </script>
}
