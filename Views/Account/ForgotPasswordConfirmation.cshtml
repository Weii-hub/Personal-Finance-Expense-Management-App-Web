@{
    ViewData["Title"] = "Xác Nhận Khôi Phục Mật Khẩu";
    bool userFound = ViewBag.UserFound == true;
    string targetEmail = ViewBag.TargetEmail as string ?? "";
    string resetLink = ViewBag.ResetLink as string ?? "";
    string fullName = ViewBag.FullName as string ?? "";
}

<div class="container mt-5 mb-5" style="max-width: 520px;">
    <div class="card border-0 rounded-4 shadow-sm p-4 text-center" style="border: 2px solid #e0e7ff !important; background: #ffffff;">
        <div class="display-3 mb-3">📬✨</div>
        <h3 class="fw-bold text-dark mb-2">Yêu Cầu Đã Được Tiếp Nhận!</h3>
        
        @if (userFound)
        {
            <p class="text-muted mb-3">
                Xin chào <strong>@fullName</strong>! Hệ thống đã tạo thành công mã Token bảo mật đặt lại mật khẩu cho tài khoản <code>@targetEmail</code>.
            </p>

            <div class="alert alert-success border-0 rounded-4 p-3 text-start mb-4" style="background: #eef2ff;">
                <div class="d-flex align-items-center mb-2">
                    <i class="fa-solid fa-circle-check text-primary fs-5 me-2"></i>
                    <strong class="text-primary">Liên kết Đặt lại Mật khẩu (Sandbox Demo)</strong>
                </div>
                <small class="text-muted d-block mb-3">
                    Trong môi trường học tập đồ án, bạn có thể bấm trực tiếp vào nút dưới đây để tiến hành đặt mật khẩu mới ngay mà không cần chờ mail:
                </small>
                <div class="d-grid gap-2">
                    <a href="@resetLink" class="btn btn-primary fw-bold rounded-pill">
                        <i class="fa-solid fa-key me-1"></i> Bấm vào đây để Đặt lại Mật khẩu ngay
                    </a>
                </div>
            </div>
        }
        else
        {
            <p class="text-muted mb-4">
                Nếu địa chỉ email <code>@targetEmail</code> tồn tại trong hệ thống, hướng dẫn đặt lại mật khẩu đã được khởi tạo theo chuẩn bảo mật an toàn.
            </p>
        }

        <div class="d-flex justify-content-center gap-3">
            <a asp-action="Login" class="btn btn-outline-secondary rounded-pill px-4">
                <i class="fa-solid fa-arrow-left me-1"></i> Về trang Đăng nhập
            </a>
        </div>
    </div>
</div>
