@model PersonalFinanceApp.Models.ViewModels.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Quên Mật Khẩu";
}

<div class="container mt-5 mb-5" style="max-width: 480px;">
    <div class="card border-0 rounded-4 shadow-sm p-4" style="border: 2px solid #ffe0d8 !important; background: #ffffff;">
        <div class="text-center mb-4">
            <div class="display-4 mb-2">🔐🕊️</div>
            <h3 class="fw-bold text-dark mb-1">Khôi phục mật khẩu</h3>
            <p class="text-muted small">Nhập email tài khoản của bạn để nhận mã khôi phục và đặt lại mật khẩu mới.</p>
        </div>

        <form asp-action="ForgotPassword" method="post" autocomplete="off">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3 fw-bold" role="alert"></div>

            <div class="mb-4">
                <label asp-for="Email" class="form-label fw-bold">Email đăng ký</label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted"><i class="fa-solid fa-envelope"></i></span>
                    <input asp-for="Email" class="form-control form-control-lg" placeholder="name@example.com" autocomplete="off" autofocus />
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="d-grid mb-3">
                <button type="submit" class="btn btn-primary btn-lg shadow-sm">
                    <i class="fa-solid fa-paper-plane me-1"></i> Tạo liên kết đặt lại mật khẩu
                </button>
            </div>

            <div class="text-center text-muted small">
                Nhớ mật khẩu rồi? 
                <a asp-action="Login" class="text-primary fw-bold text-decoration-none">Quay lại Đăng nhập</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
