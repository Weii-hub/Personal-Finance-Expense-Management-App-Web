@model PersonalFinanceApp.Models.ViewModels.ResetPasswordOtpViewModel

@{
    ViewData["Title"] = "Đặt Lại Mật Khẩu (OTP)";
    string debugOtp = ViewBag.DebugOtp as string ?? "";
}

<div class="container mt-4 mb-5" style="max-width: 480px;">
    <div class="card border-0 rounded-4 shadow-sm p-4" style="border: 2px solid #ffe0d8 !important; background: #ffffff;">
        <div class="text-center mb-4">
            <div class="display-4 mb-2">🔐🔑</div>
            <h3 class="fw-bold text-dark mb-1">Thiết lập mật khẩu mới</h3>
            <p class="text-muted small mb-0">Xác thực mã OTP gửi về email để cập nhật mật khẩu</p>
        </div>

        @if (TempData["SuccessMessage"] is string msg)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-4 small" role="alert">
                <i class="fa-solid fa-circle-check me-2"></i> @msg
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] is string errMsg)
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-4 small" role="alert">
                <i class="fa-solid fa-triangle-exclamation me-2"></i> @errMsg
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
            </div>
        }

        <div class="alert alert-info border-0 rounded-4 p-3 mb-4" style="background: #eff6ff;">
            <div class="d-flex align-items-center">
                <i class="fa-solid fa-envelope-circle-check text-primary fs-4 me-3"></i>
                <div>
                    <div class="small text-muted">Mã OTP khôi phục đã gửi đến:</div>
                    <strong class="text-dark">@Model.Email</strong>
                </div>
            </div>
        </div>

        <form asp-action="ResetPasswordOtp" method="post" autocomplete="off">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Email" />

            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3 fw-bold" role="alert"></div>

            <!-- OTP Input -->
            <div class="mb-3 text-center">
                <label asp-for="OtpCode" class="form-label fw-bold mb-2">Mã xác thực OTP (6 chữ số)</label>
                <input asp-for="OtpCode" 
                       class="form-control form-control-lg text-center fw-bold fs-2" 
                       placeholder="••••••" 
                       maxlength="6" 
                       inputmode="numeric" 
                       pattern="[0-9]*" 
                       style="letter-spacing: 12px; font-family: monospace; border: 2px solid #fed7aa; border-radius: 14px;" 
                       autofocus />
                <span asp-validation-for="OtpCode" class="text-danger small d-block mt-2"></span>
            </div>

            <!-- Countdown Timer & Resend Button -->
            <div class="d-flex justify-content-between align-items-center mb-4 px-1">
                <div class="small text-muted">
                    <i class="fa-regular fa-clock me-1 text-warning"></i>
                    Hết hạn sau: <span id="resetOtpCountdown" class="fw-bold text-danger">05:00</span>
                </div>
                <button type="button" id="btnResendResetOtp" class="btn btn-link btn-sm text-decoration-none fw-semibold p-0 text-primary">
                    <i class="fa-solid fa-rotate-right me-1"></i> Gửi lại mã OTP
                </button>
            </div>

            <hr class="my-3 opacity-25" />

            <!-- New Password -->
            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label fw-bold">Mật khẩu mới</label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted"><i class="fa-solid fa-lock"></i></span>
                    <input asp-for="NewPassword" class="form-control form-control-lg" placeholder="Ít nhất 6 ký tự" />
                </div>
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
            </div>

            <!-- Confirm Password -->
            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label fw-bold">Xác nhận mật khẩu mới</label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted"><i class="fa-solid fa-shield-halved"></i></span>
                    <input asp-for="ConfirmPassword" class="form-control form-control-lg" placeholder="Nhập lại mật khẩu mới" />
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <!-- Submit Button -->
            <div class="d-grid mb-3">
                <button type="submit" class="btn btn-primary btn-lg shadow-sm rounded-pill fw-bold">
                    <i class="fa-solid fa-check-circle me-1"></i> Cập nhật mật khẩu mới
                </button>
            </div>

            <div class="text-center text-muted small">
                Nhớ mật khẩu rồi? 
                <a asp-action="Login" class="text-primary fw-bold text-decoration-none">Quay lại Đăng nhập</a>
            </div>
        </form>

        @if (!string.IsNullOrEmpty(debugOtp))
        {
            <div class="mt-4 pt-3 border-top text-center">
                <div class="badge bg-light text-secondary border px-3 py-2 rounded-pill small fw-normal">
                    💡 <strong>Demo Hỗ trợ Báo cáo:</strong> Mã OTP là <code class="fw-bold text-primary fs-6">@debugOtp</code>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        // Countdown 5 phút
        let timeLeft = 300;
        const countdownEl = document.getElementById("resetOtpCountdown");
        const btnResend = document.getElementById("btnResendResetOtp");

        const timer = setInterval(function () {
            timeLeft--;
            if (timeLeft <= 0) {
                clearInterval(timer);
                countdownEl.innerText = "00:00 (Đã hết hạn)";
            } else {
                let minutes = Math.floor(timeLeft / 60);
                let seconds = timeLeft % 60;
                countdownEl.innerText = `${minutes < 10 ? '0' : ''}${minutes}:${seconds < 10 ? '0' : ''}${seconds}`;
            }
        }, 1000);

        // Gửi lại mã OTP qua AJAX
        btnResend.addEventListener("click", function () {
            btnResend.disabled = true;
            btnResend.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i> Đang gửi...';

            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            const email = document.querySelector('input[name="Email"]').value;

            const formData = new FormData();
            formData.append("email", email);
            formData.append("__RequestVerificationToken", token);

            fetch('@Url.Action("ResendResetOtp", "Account")', {
                method: 'POST',
                body: formData
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    timeLeft = 300; // Reset timer
                    alert("✅ " + data.message);
                    location.reload();
                } else {
                    alert("❌ " + data.message);
                }
            })
            .catch(err => {
                alert("Đã xảy ra lỗi khi gửi lại mã OTP.");
            })
            .finally(() => {
                btnResend.disabled = false;
                btnResend.innerHTML = '<i class="fa-solid fa-rotate-right me-1"></i> Gửi lại mã OTP';
            });
        });
    </script>
}
