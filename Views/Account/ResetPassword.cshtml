@model PersonalFinanceApp.Models.ViewModels.ResetPasswordViewModel

@{
    ViewData["Title"] = "Đặt Lại Mật Khẩu";
}

<div class="container mt-5 mb-5" style="max-width: 480px;">
    <div class="card border-0 rounded-4 shadow-sm p-4" style="border: 2px solid #e0e7ff !important; background: #ffffff;">
        <div class="text-center mb-4">
            <div class="display-4 mb-2">🔑✨</div>
            <h3 class="fw-bold text-dark mb-1">Thiết lập mật khẩu mới</h3>
            <p class="text-muted small">Nhập mật khẩu mới an toàn cho tài khoản <strong>@Model.Email</strong>.</p>
        </div>

        <form asp-action="ResetPassword" method="post" autocomplete="off">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Token" />
            <input type="hidden" asp-for="Email" />

            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3 fw-bold" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label fw-bold">Mật khẩu mới</label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted"><i class="fa-solid fa-lock"></i></span>
                    <input asp-for="Password" class="form-control form-control-lg" placeholder="Ít nhất 6 ký tự" autocomplete="new-password" autofocus />
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label fw-bold">Xác nhận mật khẩu mới</label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted"><i class="fa-solid fa-shield-halved"></i></span>
                    <input asp-for="ConfirmPassword" class="form-control form-control-lg" placeholder="Nhập lại mật khẩu" autocomplete="new-password" />
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <div class="d-grid mb-3">
                <button type="submit" class="btn btn-success btn-lg shadow-sm">
                    <i class="fa-solid fa-circle-check me-1"></i> Lưu mật khẩu mới & Đăng nhập
                </button>
            </div>

            <div class="text-center text-muted small">
                <a asp-action="Login" class="text-secondary text-decoration-none">
                    <i class="fa-solid fa-arrow-left me-1"></i> Hủy bỏ và quay lại Đăng nhập
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
